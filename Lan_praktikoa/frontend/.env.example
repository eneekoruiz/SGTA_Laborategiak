# ═══════════════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
#
# This file documents ALL environment variables used by the frontend.
# Copy to .env.local and set values for your environment.
#
# IMPORTANT: The frontend is now BACKEND-READY. When the FastAPI
# backend is deployed, simply set VITE_LIVE_MODE=true and the
# frontend will automatically connect to the real API.
#

# ───────────────────────────────────────────────────────────────────
# API CONFIGURATION
# ───────────────────────────────────────────────────────────────────

# LIVE_MODE: Enable real backend API calls
# Default: false (use mocks in development)
# Set to 'true' when backend is deployed
# Type: 'true' | 'false' (string)
VITE_LIVE_MODE=false

# API_URL: Backend API server address
# Default: http://localhost:8000 (FastAPI default port)
# Examples:
#   - Development: http://localhost:8000
#   - Production: https://api.simhiri.example.com
#   - Docker Compose: http://backend:8000
# Type: string (URL)
VITE_API_URL=http://localhost:8000

# API_TIMEOUT: Request timeout in milliseconds
# Not user-configurable (hardcoded to 10000 in apiService.ts)
# If you need to change, edit apiService.ts: const API_TIMEOUT = 10000
# Type: number (milliseconds)
# Default: 10000

# ───────────────────────────────────────────────────────────────────
# LOGGING & DEBUG
# ───────────────────────────────────────────────────────────────────

# DEBUG: Enable debug logging in console
# Default: true
# Set to 'false' in production to reduce logs
# Type: 'true' | 'false' (string)
VITE_DEBUG=true

# ───────────────────────────────────────────────────────────────────
# DEPLOYMENT PROFILES
# ───────────────────────────────────────────────────────────────────
#
# DEVELOPMENT (LOCAL)
#   VITE_LIVE_MODE=false
#   VITE_API_URL=http://localhost:8000
#   Result: Uses mocks, no backend needed
#
# DEVELOPMENT (WITH MOCK BACKEND)
#   VITE_LIVE_MODE=true
#   VITE_API_URL=http://localhost:8000
#   Result: Hits real backend, falls back to mocks if offline
#
# DOCKER COMPOSE (Full Stack)
#   VITE_LIVE_MODE=true
#   VITE_API_URL=http://backend:8000  (service name in docker-compose.yml)
#   Result: Container-to-container communication
#
# PRODUCTION
#   VITE_LIVE_MODE=true
#   VITE_API_URL=https://api.simhiri.example.com
#   VITE_DEBUG=false
#   Result: Real backend, no fallback, minimal logs

# ───────────────────────────────────────────────────────────────────
# TIPS FOR BACKEND DEVELOPERS
# ───────────────────────────────────────────────────────────────────
#
# 1. CORS HEADERS:
#    Your FastAPI/Flask backend MUST allow cross-origin requests.
#    Frontend is at http://localhost:5173 (Vite dev server)
#    Enable CORS for: http://localhost:5173
#    In FastAPI:
#      from fastapi.middleware.cors import CORSMiddleware
#      app.add_middleware(
#        CORSMiddleware,
#        allow_origins=["http://localhost:5173"],
#        allow_credentials=True,
#        allow_methods=["*"],
#        allow_headers=["*"],
#      )
#
# 2. API CONTRACTS:
#    See frontend/src/types/api.d.ts for exact JSON structures
#    Frontend expects responses to match these interfaces
#    Mismatch = frontend crashes, errors logged to console
#
# 3. ERROR HANDLING:
#    Frontend catches all HTTP errors (4xx, 5xx) and network errors
#    Shows user-friendly "Server Offline" notification
#    See frontend/src/services/errorHandler.ts for details
#
# 4. HEALTH CHECK:
#    Frontend calls GET /api/health to detect if backend is alive
#    Not required, but helps with "Server Offline" detection
#    Respond with: { "status": "healthy" } or 200 OK
#
# 5. TESTING:
#    To test with real backend while keeping mocks as fallback:
#    - Start frontend: npm run dev
#    - Start backend: python -m uvicorn app.main:app --reload
#    - Set VITE_LIVE_MODE=true
#    - If backend crashes, frontend automatically uses mocks
#    - Check browser console for [API] logs to track requests
