{
  "endpoint": {
    "url": "/api/ai/",
    "method": "POST",
    "description": "AA txanda kalkulatzeko endpoint-a. AIRequest jasotzen du eta AIResponse itzultzen du."
  },
  "request": {
    "type": "object",
    "properties": {
      "game_state": {
        "type": "object",
        "description": "Jokoaren uneko egoera osoa (GameState, SPECS.md-ren arabera)."
      },
      "historia": {
        "type": "array",
        "description": "Azken 5 hilabeteetako laburpena edo elkarrizketa."
      }
    },
    "required": ["game_state", "historia"]
  },
  "response": {
    "type": "object",
    "properties": {
      "ekintzak": {
        "type": "array",
        "description": "AA-k proposatutako ekintzak.",
        "items": {
          "type": "object",
          "properties": {
            "mota": {"type": "string", "description": "Ekintzaren mota. Ikusi 'allowed_action_types'."},
            "parametroak": {"type": "object", "description": "Ekintzaren parametroak, mota bakoitzaren arabera."}
          },
          "required": ["mota", "parametroak"]
        }
      },
      "reasoning": {
        "type": "object",
        "properties": {
          "testuingurua": {"type": "string", "description": "AA-ren testuinguruaren azalpena."},
          "analisia": {"type": "string", "description": "AA-ren ekintzen analisia."}
        },
        "required": ["testuingurua", "analisia"]
      },
      "success": {"type": "boolean", "description": "Eragiketaren arrakasta."},
      "erroreak": {"type": "array", "items": {"type": "string"}, "description": "Erroreen zerrenda, badaude."}
    },
    "required": ["ekintzak", "reasoning", "success"]
  },
  "allowed_action_types": [
    "zone",
    "infrastructure",
    "build",
    "demolish",
    "budget",
    "ordinance",
    "bond",
    "attack",
    "pass"
  ],
  "examples": {
    "request": {
      "game_state": {
        "current_date": {"year": 1995, "month": 6},
        "ai_city": {"name": "AI Hiria", "treasury": 1200, "population": 5000},
        "player_city": {"name": "Jokalari Hiria", "treasury": 800, "population": 6000},
        "difficulty": "medium"
      },
      "historia": [
        {"month": 5, "event": "Eskola berria eraiki da."},
        {"month": 6, "event": "Ospitalea finantzatu da."}
      ]
    },
    "response": {
      "ekintzak": [
        {
          "mota": "build",
          "parametroak": {"building_type": "hospital", "position": {"x": 10, "y": 5}}
        },
        {
          "mota": "budget",
          "parametroak": {"tax_rates": {"residential": 7, "commercial": 7, "industrial": 7}, "funding": {"health": 110, "education": 100}}
        },
        {
          "mota": "pass",
          "parametroak": {}
        }
      ],
      "reasoning": {
        "testuingurua": "Osasun metrika baxua zegoen, horregatik ospitalea eraiki da.",
        "analisia": "Aukeratutako ekintzak aurrekontuaren barruan daude eta hiriaren ongizatea hobetuko dute."
      },
      "success": true,
      "erroreak": []
    }
  }
}
